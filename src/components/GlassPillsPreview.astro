---
/**
 * Decorative Glass Pills (style1) public-menu preview.
 * Closely mirrors Frontend style1: glass header, indigo pills, list cards.
 */
const categories = ['All', 'Mains', 'Sides', 'Drinks'];
const items = [
  {
    name: 'Grilled Hammour',
    desc: 'Lemon butter, herbs, seasonal greens',
    price: '4.500',
    badge: 'Popular' as const,
    image: '/images/dish-hammour.webp',
  },
  {
    name: 'Machboos Dajaj',
    desc: 'Spiced rice, chicken, yogurt',
    price: '3.250',
    badge: null,
    image: '/images/dish-machboos.webp',
  },
  {
    name: 'Fattoush Salad',
    desc: 'Crisp greens, sumac, toasted bread',
    price: '2.100',
    badge: null,
    image: '/images/dish-hammour.webp',
  },
  {
    name: 'Fresh Lemon Mint',
    desc: 'Chilled citrus mint cooler',
    price: '1.200',
    badge: 'New' as const,
    image: '/images/dish-lemon-mint.webp',
  },
];
---

<div class="phone relative mx-auto w-full max-w-[288px] select-none sm:max-w-[304px]" aria-hidden="true">
  <!-- Soft ground shadow -->
  <div class="phone__glow"></div>

  <!-- Device shell -->
  <div class="phone__shell">
    <!-- Side buttons -->
    <span class="phone__btn phone__btn--silent"></span>
    <span class="phone__btn phone__btn--vol-up"></span>
    <span class="phone__btn phone__btn--vol-down"></span>
    <span class="phone__btn phone__btn--power"></span>

    <div class="phone__bezel">
      <div class="phone__screen">
        <!-- Status bar -->
        <div class="phone__status">
          <span class="phone__time">9:41</span>
          <div class="phone__island"></div>
          <div class="phone__status-right">
            <svg class="phone__ico" viewBox="0 0 17 12" fill="currentColor" aria-hidden="true">
              <rect x="0" y="7.5" width="3" height="4.5" rx="0.6" opacity="0.35"></rect>
              <rect x="4.5" y="5" width="3" height="7" rx="0.6" opacity="0.55"></rect>
              <rect x="9" y="2.5" width="3" height="9.5" rx="0.6" opacity="0.75"></rect>
              <rect x="13.5" y="0" width="3" height="12" rx="0.6"></rect>
            </svg>
            <svg class="phone__ico phone__ico--wifi" viewBox="0 0 16 12" fill="currentColor" aria-hidden="true">
              <path d="M8 9.6a1.2 1.2 0 1 1 0 2.4 1.2 1.2 0 0 1 0-2.4Z"></path>
              <path d="M4.4 7.4a5.1 5.1 0 0 1 7.2 0l-.9.9a3.8 3.8 0 0 0-5.4 0l-.9-.9Z" opacity="0.7"></path>
              <path d="M1.8 4.8a8.7 8.7 0 0 1 12.4 0l-.9.9a7.4 7.4 0 0 0-10.6 0l-.9-.9Z" opacity="0.4"></path>
            </svg>
            <svg class="phone__ico phone__ico--bat" viewBox="0 0 28 13" fill="none" aria-hidden="true">
              <rect x="0.6" y="0.6" width="23" height="11.8" rx="2.4" stroke="currentColor" stroke-width="1.2" opacity="0.45"></rect>
              <rect x="2.2" y="2.2" width="18.2" height="8.6" rx="1.4" fill="currentColor"></rect>
              <path d="M25.2 4.2h1.2a1.4 1.4 0 0 1 1.4 1.4v1.8a1.4 1.4 0 0 1-1.4 1.4h-1.2" fill="currentColor" opacity="0.45"></path>
            </svg>
          </div>
        </div>

        <!-- App chrome (Glass Pills) -->
        <div class="menu">
          <div class="menu__header">
            <span class="menu__back">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M15 19l-7-7 7-7"></path>
              </svg>
            </span>
            <span class="menu__logo">
              <span class="menu__monogram">CK</span>
            </span>
            <span class="menu__name">Coastal Kitchen</span>
          </div>

          <div class="menu__pills">
            {
              categories.map((cat, i) => (
                <span class:list={['menu__pill', i === 0 && 'is-active']}>{cat}</span>
              ))
            }
          </div>

          <div class="menu__list">
            {
              items.map((item) => (
                <div class="menu__card">
                  <div class="menu__thumb">
                    <img src={item.image} alt="" width="96" height="96" loading="lazy" />
                    <div class="menu__thumb-shade"></div>
                    {item.badge && (
                      <span class:list={['menu__badge', item.badge === 'New' ? 'is-new' : 'is-popular']}>
                        {item.badge}
                      </span>
                    )}
                  </div>
                  <div class="menu__body">
                    <div>
                      <p class="menu__title">{item.name}</p>
                      <p class="menu__desc">{item.desc}</p>
                    </div>
                    <div class="menu__row">
                      <div class="menu__price">
                        <span class="menu__amount">{item.price}</span>
                        <span class="menu__currency">KWD</span>
                      </div>
                      <span class="menu__view">View</span>
                    </div>
                  </div>
                </div>
              ))
            }
          </div>
        </div>

        <div class="phone__home"></div>
      </div>
    </div>
  </div>
</div>

<style>
  .phone {
    perspective: 900px;
  }

  .phone__glow {
    position: absolute;
    left: 8%;
    right: 8%;
    bottom: -1.1rem;
    height: 2.4rem;
    border-radius: 100%;
    background: radial-gradient(ellipse at center, rgba(18, 21, 28, 0.28), transparent 70%);
    filter: blur(6px);
    z-index: 0;
  }

  .phone__shell {
    position: relative;
    z-index: 1;
    border-radius: 2.55rem;
    padding: 0.42rem;
    background:
      linear-gradient(160deg, #3a3f4a 0%, #1a1d24 42%, #0e1014 100%);
    box-shadow:
      0 1px 0 rgba(255, 255, 255, 0.18) inset,
      0 -1px 0 rgba(0, 0, 0, 0.35) inset,
      0 28px 50px -20px rgba(18, 21, 28, 0.55),
      0 50px 80px -36px rgba(15, 118, 110, 0.28);
  }

  .phone__btn {
    position: absolute;
    background: linear-gradient(90deg, #2a2e36, #1a1d24);
    border-radius: 2px;
    z-index: 2;
  }

  .phone__btn--silent {
    left: -2px;
    top: 6.4rem;
    width: 3px;
    height: 1.15rem;
  }

  .phone__btn--vol-up {
    left: -2px;
    top: 8.5rem;
    width: 3px;
    height: 2rem;
  }

  .phone__btn--vol-down {
    left: -2px;
    top: 11rem;
    width: 3px;
    height: 2rem;
  }

  .phone__btn--power {
    right: -2px;
    top: 9.2rem;
    width: 3px;
    height: 3.1rem;
  }

  .phone__bezel {
    border-radius: 2.2rem;
    overflow: hidden;
    background: #000;
    padding: 0.28rem;
    box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.06) inset;
  }

  .phone__screen {
    position: relative;
    height: 33.5rem;
    overflow: hidden;
    border-radius: 1.95rem;
    background: linear-gradient(145deg, #eff6ff 0%, #eef2ff 48%, #f5f3ff 100%);
    color: #111827;
  }

  .phone__status {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    z-index: 20;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    padding: 0.72rem 1.05rem 0.35rem;
    pointer-events: none;
  }

  .phone__time {
    font-size: 0.72rem;
    font-weight: 650;
    letter-spacing: -0.02em;
    color: #111827;
  }

  .phone__island {
    width: 5.1rem;
    height: 1.35rem;
    border-radius: 9999px;
    background: #0a0a0b;
    box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.06) inset;
  }

  .phone__status-right {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: 0.28rem;
    color: #111827;
  }

  .phone__ico {
    width: 0.95rem;
    height: 0.7rem;
  }

  .phone__ico--wifi {
    width: 0.9rem;
  }

  .phone__ico--bat {
    width: 1.35rem;
    height: 0.65rem;
  }

  .menu {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 2.55rem 0.85rem 1.6rem;
  }

  .menu__header {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.55rem 0.65rem;
    border-radius: 1rem;
    background: rgba(255, 255, 255, 0.6);
    border: 1px solid rgba(255, 255, 255, 0.35);
    box-shadow: 0 8px 20px -14px rgba(15, 23, 42, 0.35);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }

  .menu__back {
    display: grid;
    place-items: center;
    width: 1.7rem;
    height: 1.7rem;
    border-radius: 9999px;
    color: #111827;
    flex-shrink: 0;
  }

  .menu__back svg {
    width: 0.95rem;
    height: 0.95rem;
  }

  .menu__logo {
    display: grid;
    place-items: center;
    width: 2.05rem;
    height: 2.05rem;
    border-radius: 0.7rem;
    background: rgba(255, 255, 255, 0.7);
    border: 1px solid rgba(255, 255, 255, 0.5);
    overflow: hidden;
    flex-shrink: 0;
  }

  .menu__monogram {
    font-family: var(--font-display);
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: -0.04em;
    color: #4338ca;
  }

  .menu__name {
    min-width: 0;
    font-size: 0.78rem;
    font-weight: 650;
    letter-spacing: -0.01em;
    color: #1f2937;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .menu__pills {
    display: flex;
    gap: 0.4rem;
    margin-top: 0.85rem;
    overflow: hidden;
  }

  .menu__pill {
    flex-shrink: 0;
    padding: 0.42rem 0.75rem;
    border-radius: 0.7rem;
    font-size: 0.68rem;
    font-weight: 600;
    color: #4f46e5;
    background: rgba(255, 255, 255, 0.6);
    border: 1px solid rgba(165, 180, 252, 0.55);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }

  .menu__pill.is-active {
    color: #4338ca;
    background: rgba(165, 180, 252, 0.42);
    border-color: rgba(165, 180, 252, 0.35);
    box-shadow: 0 4px 12px -8px rgba(79, 70, 229, 0.55);
  }

  .menu__list {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    margin-top: 0.85rem;
    min-height: 0;
    overflow: hidden;
  }

  .menu__card {
    display: flex;
    overflow: hidden;
    border-radius: 0.75rem;
    background: rgba(255, 255, 255, 0.5);
    border: 1px solid rgba(255, 255, 255, 0.28);
    box-shadow: 0 8px 18px -14px rgba(15, 23, 42, 0.45);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
  }

  .menu__thumb {
    position: relative;
    width: 5.35rem;
    height: 5.35rem;
    flex-shrink: 0;
    overflow: hidden;
  }

  .menu__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .menu__thumb-shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(0, 0, 0, 0.18), transparent);
  }

  .menu__badge {
    position: absolute;
    top: 0.35rem;
    left: 0.35rem;
    padding: 0.12rem 0.38rem;
    border-radius: 9999px;
    font-size: 0.52rem;
    font-weight: 700;
    letter-spacing: 0.01em;
    color: white;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.18);
    backdrop-filter: blur(4px);
  }

  .menu__badge.is-popular {
    background: rgba(245, 158, 11, 0.92);
  }

  .menu__badge.is-new {
    background: rgba(34, 197, 94, 0.92);
  }

  .menu__body {
    display: flex;
    flex: 1;
    min-width: 0;
    flex-direction: column;
    justify-content: space-between;
    padding: 0.55rem 0.6rem 0.55rem 0.65rem;
  }

  .menu__title {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: -0.015em;
    color: #111827;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .menu__desc {
    margin-top: 0.15rem;
    font-size: 0.58rem;
    line-height: 1.35;
    color: #4b5563;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .menu__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.4rem;
    margin-top: 0.35rem;
  }

  .menu__price {
    display: flex;
    align-items: baseline;
    gap: 0.2rem;
    min-width: 0;
  }

  .menu__amount {
    font-size: 0.82rem;
    font-weight: 750;
    letter-spacing: -0.02em;
    color: #4f46e5;
  }

  .menu__currency {
    font-size: 0.55rem;
    font-weight: 600;
    color: #4b5563;
  }

  .menu__view {
    flex-shrink: 0;
    padding: 0.28rem 0.55rem;
    border-radius: 0.45rem;
    font-size: 0.58rem;
    font-weight: 700;
    color: #4338ca;
    background: rgba(99, 102, 241, 0.16);
    border: 1px solid rgba(129, 140, 248, 0.35);
  }

  .phone__home {
    position: absolute;
    left: 50%;
    bottom: 0.45rem;
    width: 6.5rem;
    height: 0.28rem;
    border-radius: 9999px;
    background: rgba(17, 24, 39, 0.28);
    transform: translateX(-50%);
  }

  @media (min-width: 640px) {
    .phone__screen {
      height: 34.75rem;
    }
  }
</style>

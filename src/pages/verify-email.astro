---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../lib/site';

const apiBaseUrl = siteConfig.apiBaseUrl;
const panelUrl = siteConfig.panelUrl;
const token = Astro.url.searchParams.get('token') || '';
---

<BaseLayout
  title="Verify email"
  description="Confirm your Platen account email."
  canonicalPath="/verify-email"
  noindex={true}
>
  <section class="relative mx-auto max-w-md px-5 py-16 sm:px-8 sm:py-24">
    <p class="font-display text-sm font-semibold text-primary">Platen</p>
    <h1 class="font-display mt-3 text-3xl font-semibold tracking-tight text-ink sm:text-4xl">
      Verify email
    </h1>

    <div id="verify-status" class="mt-8 rounded-xl border border-border bg-surface p-5" role="status">
      <p id="verify-message" class="text-sm leading-relaxed text-muted">
        {token ? 'Verifying your email…' : 'Missing verification link. Check your email and try again.'}
      </p>
      <a
        id="verify-login"
        href={panelUrl}
        class="mt-6 inline-flex w-full items-center justify-center rounded-lg bg-primary px-4 py-3.5 text-sm font-semibold text-on-primary transition hover:bg-primary-hover"
        style={token ? 'display:none' : undefined}
      >
        Continue to log in
      </a>
      <a
        href="/signup"
        class="mt-3 inline-flex w-full items-center justify-center rounded-lg border border-border px-4 py-3 text-sm font-semibold text-ink transition-colors hover:bg-tint/40"
      >
        Back to signup
      </a>
    </div>
  </section>
</BaseLayout>

<script define:vars={{ apiBaseUrl, token }}>
  async function runVerify() {
    const messageEl = document.getElementById('verify-message');
    const loginEl = document.getElementById('verify-login');
    if (!token) return;

    try {
      const res = await fetch(`${apiBaseUrl}/auth/verify-email`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ token }),
      });
      const data = await res.json().catch(() => ({}));
      if (!res.ok) {
        throw new Error(data?.error?.message || data?.message || 'Verification failed');
      }
      if (messageEl) {
        messageEl.textContent =
          data.message || 'Email verified. You can sign in to the panel now.';
        messageEl.classList.remove('text-muted');
        messageEl.classList.add('text-ink');
      }
      if (loginEl) loginEl.style.display = 'inline-flex';
    } catch (err) {
      if (messageEl) {
        messageEl.textContent = err?.message || 'Invalid or expired verification link.';
        messageEl.classList.add('text-red-700');
      }
      if (loginEl) loginEl.style.display = 'inline-flex';
    }
  }

  runVerify();
  document.addEventListener('astro:page-load', runVerify);
</script>

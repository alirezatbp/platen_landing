---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../lib/site';

const apiBaseUrl = siteConfig.apiBaseUrl;
const panelUrl = siteConfig.panelUrl;

/**
 * Atmosphere options — set `activeSignupImage` to '01'…'05' when you choose.
 * 01 QR table · 02 guest phone · 03 plated dish · 04 empty room · 05 owner desk
 */
const signupImages = {
  '01': {
    webp: '/images/signup-01-qr-table.webp',
    jpg: '/images/signup-01-qr-table.png',
  },
  '02': {
    webp: '/images/signup-02-guest-phone.webp',
    jpg: '/images/signup-02-guest-phone.png',
  },
  '03': {
    webp: '/images/signup-03-plated-dish.webp',
    jpg: '/images/signup-03-plated-dish.png',
  },
  '04': {
    webp: '/images/signup-04-empty-room.webp',
    jpg: '/images/signup-04-empty-room.png',
  },
  '05': {
    webp: '/images/signup-05-owner-desk.webp',
    jpg: '/images/signup-05-owner-desk.png',
  },
} as const;

const activeSignupImage: keyof typeof signupImages = '01';
const atmosphere = signupImages[activeSignupImage];
---

<BaseLayout
  title="Create your Free account"
  description="Register your restaurant on Platen. Free forever for one venue — verify your email, then build in the panel."
  canonicalPath="/signup"
>
  <div class="su">
    <aside class="su__visual" aria-hidden="true">
      <picture>
        <source srcset={atmosphere.webp} type="image/webp" />
        <img
          src={atmosphere.jpg}
          alt=""
          width="1400"
          height="1800"
          class="su__photo"
          decoding="async"
          fetchpriority="high"
        />
      </picture>
      <div class="su__visual-fade"></div>
      <p class="su__visual-mark">Platen</p>
      <p class="su__visual-note">Free forever · One venue · No card</p>
    </aside>

    <section class="su__main" aria-labelledby="su-heading">
      <div class="su__main-inner">
        <header class="su__intro" id="su-intro">
          <p class="su__kicker">Get started</p>
          <h1 id="su-heading" class="su__title">Create your Free account</h1>
          <p class="su__lead">
            Register your restaurant, confirm your email, then sign in to the panel to publish
            your menu.
          </p>
        </header>

        <div id="signup-success" class="su__success hidden" role="status">
          <div class="su__success-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" width="28" height="28">
              <path
                d="M4 7.5A2.5 2.5 0 0 1 6.5 5h11A2.5 2.5 0 0 1 20 7.5v9a2.5 2.5 0 0 1-2.5 2.5h-11A2.5 2.5 0 0 1 4 16.5v-9Z"
                stroke="currentColor"
                stroke-width="1.5"></path>
              <path
                d="m5.5 8.5 6.5 4.5 6.5-4.5"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
            </svg>
          </div>
          <h2 class="su__success-title">Check your email</h2>
          <p id="signup-success-msg" class="su__success-msg"></p>
          <p id="signup-stub-wrap" class="su__stub hidden">
            <span class="su__stub-label">Dev stub</span>
            <a id="signup-stub-link" href="#">Open verification link</a>
          </p>
          <a href={panelUrl} class="su__btn su__btn--secondary">Continue to log in</a>
        </div>

        <div id="su-oauth" class="su__oauth">
          <button type="button" id="signup-google" class="su__btn su__btn--google">
            <svg class="su__google-icon" viewBox="0 0 24 24" aria-hidden="true" width="18" height="18">
              <path
                fill="#4285F4"
                d="M23.49 12.27c0-.79-.07-1.54-.19-2.27H12v4.3h6.44a5.5 5.5 0 0 1-2.39 3.61v3h3.86c2.26-2.08 3.58-5.15 3.58-8.64Z"
              ></path>
              <path
                fill="#34A853"
                d="M12 24c3.24 0 5.95-1.07 7.93-2.91l-3.86-3a7.2 7.2 0 0 1-4.07 1.15c-3.13 0-5.78-2.11-6.73-4.95H1.28v3.11A12 12 0 0 0 12 24Z"
              ></path>
              <path
                fill="#FBBC05"
                d="M5.27 14.29A7.2 7.2 0 0 1 4.89 12c0-.8.14-1.57.38-2.29V6.6H1.28A12 12 0 0 0 0 12c0 1.94.46 3.77 1.28 5.4l3.99-3.11Z"
              ></path>
              <path
                fill="#EA4335"
                d="M12 4.75c1.77 0 3.35.61 4.6 1.8l3.44-3.44C17.94 1.14 15.24 0 12 0A12 12 0 0 0 1.28 6.6l3.99 3.11C6.22 6.86 8.87 4.75 12 4.75Z"
              ></path>
            </svg>
            Sign up with Google
          </button>
          <p id="signup-google-note" class="su__google-note hidden" role="status"></p>
          <div class="su__divider" role="separator">
            <span>or continue with email</span>
          </div>
        </div>

        <form id="signup-form" class="su__form" novalidate>
          <div class="su__field">
            <label for="restaurantName">Restaurant name</label>
            <input
              id="restaurantName"
              name="restaurantName"
              type="text"
              autocomplete="organization"
              required
              minlength="2"
              maxlength="100"
              placeholder="North Gate Bistro"
            />
          </div>

          <div class="su__field">
            <label for="ownerName">Your name</label>
            <input
              id="ownerName"
              name="name"
              type="text"
              autocomplete="name"
              required
              minlength="2"
              maxlength="80"
              placeholder="Sam Rivera"
            />
          </div>

          <div class="su__field">
            <label for="email">Email</label>
            <input
              id="email"
              name="email"
              type="email"
              autocomplete="email"
              required
              placeholder="you@restaurant.com"
            />
          </div>

          <div class="su__field">
            <label for="password">
              Password
              <span>Min. 6 characters</span>
            </label>
            <input
              id="password"
              name="password"
              type="password"
              autocomplete="new-password"
              required
              minlength="6"
              placeholder="••••••••"
            />
          </div>

          <label class="su__check">
            <input type="checkbox" name="acceptedTerms" required />
            <span>
              I agree to the
              <a href="/terms" target="_blank" rel="noopener">Terms</a>
              and
              <a href="/privacy" target="_blank" rel="noopener">Privacy Policy</a>.
            </span>
          </label>

          <p id="signup-error" class="su__error hidden" role="alert"></p>

          <button type="submit" id="signup-submit" class="su__btn su__btn--primary">
            Create Free account
          </button>
        </form>

        <p class="su__foot" id="su-foot">
          Already have an account?
          <a href={panelUrl}>Sign in</a>
        </p>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .su {
    display: grid;
    min-height: calc(100vh - 4rem);
    background: var(--color-surface);
  }

  @media (min-width: 640px) {
    .su {
      min-height: calc(100vh - 4.75rem);
    }
  }

  @media (min-width: 960px) {
    .su {
      grid-template-columns: minmax(0, 1.05fr) minmax(22rem, 0.95fr);
    }
  }

  /* —— Visual column (photo only) —— */
  .su__visual {
    position: relative;
    display: none;
    overflow: hidden;
    background: #161a20;
  }

  @media (min-width: 960px) {
    .su__visual {
      display: block;
      min-height: calc(100vh - 4.75rem);
    }
  }

  .su__photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 40%;
    animation: su-ken 1.6s cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  .su__visual-fade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(18, 21, 28, 0.2) 0%, transparent 28%, transparent 62%, rgba(18, 21, 28, 0.55) 100%);
  }

  .su__visual-mark {
    position: absolute;
    top: 1.75rem;
    left: 1.75rem;
    margin: 0;
    font-family: var(--font-display);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.92);
  }

  .su__visual-note {
    position: absolute;
    left: 1.75rem;
    bottom: 1.75rem;
    margin: 0;
    font-size: 0.85rem;
    letter-spacing: 0.02em;
    color: rgba(255, 255, 255, 0.78);
  }

  /* —— Form column —— */
  .su__main {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem 1.25rem 2.75rem;
    background:
      radial-gradient(ellipse 80% 50% at 100% 0%, color-mix(in srgb, var(--color-tint) 55%, transparent), transparent 60%),
      var(--color-surface);
  }

  @media (min-width: 640px) {
    .su__main {
      padding: 2.5rem 2.5rem 3rem;
    }
  }

  .su__main-inner {
    width: 100%;
    max-width: 24.5rem;
    animation: su-rise 0.55s cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  .su__kicker {
    margin: 0;
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-primary);
  }

  .su__title {
    margin: 0.55rem 0 0;
    font-family: var(--font-display);
    font-size: clamp(1.85rem, 3.5vw, 2.15rem);
    font-weight: 600;
    letter-spacing: -0.035em;
    line-height: 1.12;
    color: var(--color-ink);
  }

  .su__lead {
    margin: 0.7rem 0 0;
    font-size: 0.98rem;
    line-height: 1.55;
    color: var(--color-muted);
  }

  .su__oauth {
    margin-top: 1.5rem;
  }

  .su__btn--google {
    gap: 0.65rem;
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    color: var(--color-ink);
    box-shadow: 0 1px 0 color-mix(in srgb, white 80%, transparent) inset;
  }

  .su__btn--google:hover {
    border-color: color-mix(in srgb, var(--color-ink) 18%, var(--color-border));
    background: color-mix(in srgb, var(--color-bg) 65%, white);
  }

  .su__google-icon {
    flex-shrink: 0;
  }

  .su__google-note {
    margin: 0.65rem 0 0;
    border-radius: 0.5rem;
    border: 1px solid color-mix(in srgb, var(--color-primary) 22%, var(--color-border));
    background: color-mix(in srgb, var(--color-tint) 45%, white);
    padding: 0.6rem 0.75rem;
    font-size: 0.84rem;
    line-height: 1.45;
    color: var(--color-ink);
  }

  .su__divider {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    margin: 1.15rem 0 0;
    color: var(--color-muted);
    font-size: 0.78rem;
  }

  .su__divider::before,
  .su__divider::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--color-border);
  }

  .su__form {
    margin-top: 1.15rem;
    display: grid;
    gap: 1.05rem;
  }

  .su__field label {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
    font-size: 0.84rem;
    font-weight: 600;
    color: var(--color-ink);
  }

  .su__field label span {
    font-size: 0.72rem;
    font-weight: 500;
    color: var(--color-muted);
  }

  .su__field input {
    margin-top: 0.4rem;
    width: 100%;
    border-radius: 0.55rem;
    border: 1px solid var(--color-border);
    background: var(--color-bg);
    padding: 0.78rem 0.9rem;
    font-size: 0.95rem;
    color: var(--color-ink);
    transition:
      border-color 0.15s ease,
      box-shadow 0.15s ease,
      background-color 0.15s ease;
  }

  .su__field input::placeholder {
    color: color-mix(in srgb, var(--color-muted) 62%, transparent);
  }

  .su__field input:hover {
    border-color: color-mix(in srgb, var(--color-primary) 28%, var(--color-border));
  }

  .su__field input:focus {
    outline: none;
    background: var(--color-surface);
    border-color: var(--color-primary);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-primary) 16%, transparent);
  }

  .su__check {
    display: flex;
    gap: 0.65rem;
    align-items: flex-start;
    margin-top: 0.1rem;
    font-size: 0.84rem;
    line-height: 1.45;
    color: var(--color-muted);
    cursor: pointer;
  }

  .su__check input {
    margin-top: 0.18rem;
    width: 1rem;
    height: 1rem;
    flex-shrink: 0;
    accent-color: var(--color-primary);
    cursor: pointer;
  }

  .su__check a {
    color: var(--color-primary);
    font-weight: 600;
    text-decoration: none;
  }

  .su__check a:hover {
    text-decoration: underline;
  }

  .su__error {
    margin: 0;
    border-radius: 0.5rem;
    border: 1px solid color-mix(in srgb, var(--color-destructive) 28%, transparent);
    background: color-mix(in srgb, var(--color-destructive) 7%, white);
    padding: 0.65rem 0.8rem;
    font-size: 0.84rem;
    color: var(--color-destructive);
  }

  .su__btn {
    display: inline-flex;
    width: 100%;
    align-items: center;
    justify-content: center;
    border-radius: 0.55rem;
    padding: 0.88rem 1rem;
    font-size: 0.92rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    transition:
      background-color 0.15s ease,
      border-color 0.15s ease,
      transform 0.15s ease,
      opacity 0.15s ease;
  }

  .su__btn--primary {
    margin-top: 0.2rem;
    border: none;
    background: var(--color-primary);
    color: var(--color-on-primary);
  }

  .su__btn--primary:hover:not(:disabled) {
    background: var(--color-primary-hover);
    transform: translateY(-1px);
  }

  .su__btn--primary:disabled {
    cursor: not-allowed;
    opacity: 0.65;
  }

  .su__btn--secondary {
    margin-top: 1.25rem;
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    color: var(--color-ink);
  }

  .su__btn--secondary:hover {
    border-color: color-mix(in srgb, var(--color-primary) 30%, var(--color-border));
    background: color-mix(in srgb, var(--color-tint) 35%, white);
  }

  .su__foot {
    margin: 1.5rem 0 0;
    text-align: center;
    font-size: 0.88rem;
    color: var(--color-muted);
  }

  .su__foot a {
    font-weight: 600;
    color: var(--color-primary);
    text-decoration: none;
  }

  .su__foot a:hover {
    text-decoration: underline;
  }

  .su__success {
    margin-top: 1.75rem;
    text-align: center;
  }

  .su__success-icon {
    margin: 0 auto;
    display: flex;
    width: 3rem;
    height: 3rem;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-tint) 75%, white);
    color: var(--color-primary);
  }

  .su__success-title {
    margin: 0.9rem 0 0;
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 600;
    color: var(--color-ink);
  }

  .su__success-msg {
    margin: 0.5rem 0 0;
    font-size: 0.94rem;
    line-height: 1.55;
    color: var(--color-muted);
  }

  .su__stub {
    margin-top: 1rem;
    padding: 0.75rem 0.85rem;
    border-radius: 0.55rem;
    border: 1px dashed color-mix(in srgb, var(--color-primary) 35%, var(--color-border));
    background: color-mix(in srgb, var(--color-tint) 35%, white);
    text-align: left;
  }

  .su__stub-label {
    display: block;
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .su__stub a {
    display: inline-block;
    margin-top: 0.2rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-primary);
    word-break: break-all;
  }

  .hidden {
    display: none !important;
  }

  @keyframes su-rise {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes su-ken {
    from {
      transform: scale(1.06);
    }
    to {
      transform: scale(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .su__photo,
    .su__main-inner {
      animation: none;
    }
  }
</style>

<script define:vars={{ apiBaseUrl }}>
  function initSignupForm() {
    const form = document.getElementById('signup-form');
    const success = document.getElementById('signup-success');
    const successMsg = document.getElementById('signup-success-msg');
    const errorEl = document.getElementById('signup-error');
    const submitBtn = document.getElementById('signup-submit');
    const stubWrap = document.getElementById('signup-stub-wrap');
    const stubLink = document.getElementById('signup-stub-link');
    const intro = document.getElementById('su-intro');
    const foot = document.getElementById('su-foot');

    if (!(form instanceof HTMLFormElement) || form.dataset.bound === '1') return;
    form.dataset.bound = '1';

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (errorEl) {
        errorEl.classList.add('hidden');
        errorEl.textContent = '';
      }

      const fd = new FormData(form);
      const restaurantName = String(fd.get('restaurantName') || '').trim();
      const name = String(fd.get('name') || '').trim();
      const email = String(fd.get('email') || '').trim();
      const password = String(fd.get('password') || '');
      const acceptedTerms = fd.get('acceptedTerms') === 'on';

      if (!acceptedTerms) {
        if (errorEl) {
          errorEl.textContent = 'Please accept the Terms and Privacy Policy.';
          errorEl.classList.remove('hidden');
        }
        return;
      }

      if (submitBtn instanceof HTMLButtonElement) {
        submitBtn.disabled = true;
        submitBtn.textContent = 'Creating account…';
      }

      try {
        const res = await fetch(`${apiBaseUrl}/auth/signup`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            restaurantName,
            name,
            email,
            password,
            acceptedTerms: true,
          }),
        });
        const data = await res.json().catch(() => ({}));

        if (!res.ok) {
          const fieldError = data?.error?.errors?.[0]?.msg;
          const message =
            fieldError ||
            data?.error?.message ||
            data?.message ||
            'Could not create account. Please try again.';
          throw new Error(message);
        }

        form.classList.add('hidden');
        if (intro) intro.classList.add('hidden');
        if (foot) foot.classList.add('hidden');
        const oauth = document.getElementById('su-oauth');
        if (oauth) oauth.classList.add('hidden');
        if (success) success.classList.remove('hidden');
        if (successMsg) {
          successMsg.textContent =
            data.message ||
            'Account created. Check your email to verify before signing in.';
        }

        const verifyUrl = data?.data?.devVerifyUrl;
        if (verifyUrl && stubWrap && stubLink) {
          stubWrap.classList.remove('hidden');
          stubLink.setAttribute('href', verifyUrl);
        }
      } catch (err) {
        if (errorEl) {
          errorEl.textContent = err?.message || 'Could not create account.';
          errorEl.classList.remove('hidden');
        }
      } finally {
        if (submitBtn instanceof HTMLButtonElement) {
          submitBtn.disabled = false;
          submitBtn.textContent = 'Create Free account';
        }
      }
    });
  }

  initSignupForm();
  document.addEventListener('astro:page-load', initSignupForm);

  function initGoogleSignup() {
    const btn = document.getElementById('signup-google');
    const note = document.getElementById('signup-google-note');
    if (!(btn instanceof HTMLButtonElement) || btn.dataset.bound === '1') return;
    btn.dataset.bound = '1';

    btn.addEventListener('click', () => {
      if (note) {
        note.textContent = 'Google sign-up is coming soon. Please create your account with email for now.';
        note.classList.remove('hidden');
      }
    });
  }

  initGoogleSignup();
  document.addEventListener('astro:page-load', initGoogleSignup);
</script>
